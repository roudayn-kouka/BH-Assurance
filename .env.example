# Copy to .env and replace every demo value before any shared deployment. Never commit .env.

# --- infrastructure (docker-compose.yaml) ---
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
MSSQL_SA_PASSWORD=change-me-Str0ng!
SQLPAD_ADMIN=admin
SQLPAD_ADMIN_PASSWORD=change-me

# --- agent ---
# Models (defaults shown). On a 16 GB machine all four fit; lighter options, e.g.
# NEXTBH_LLM_MODEL=gemma3n:e2b or NEXTBH_EMBEDDING_MODEL=intfloat/multilingual-e5-small,
# require re-running `python scripts/nextbh.py models` and, for embeddings, `... rag`.
NEXTBH_LLM_MODEL=gemma3n:e4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXTBH_LLM_SMALL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
NEXTBH_INTENT_MODEL=joeddav/xlm-roberta-large-xnli
NEXTBH_EMBEDDING_MODEL=intfloat/multilingual-e5-large
MONGODB_URI=mongodb://localhost:27017/BH
RECO_API_URL=http://localhost:8083
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Next-BH 2.0 feature flags (all off = legacy behaviour) ---
NEXTBH_USE_ORCHESTRATOR=false
NEXTBH_POLICY_MODE=off            # off | shadow | active
POLICY_SERVICE_URL=http://localhost:8010
POLICY_TIMEOUT_S=2.0
RAG_INDEX_MANIFEST=               # e.g. artifacts/rag/latest.json
NEXTBH_PUBLISH_EVENTS=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DECISION_EVENTS_TOPIC=decision_events

# --- MLOps ---
ARTIFACT_ROOT=artifacts
POLICY_MODEL_MANIFEST=artifacts/rl/latest.json
MLFLOW_TRACKING_URI=http://localhost:5000
DVC_REMOTE=
