diff --git a/frontend/src/pages/PilotLogin.tsx b/frontend/src/pages/PilotLogin.tsx
new file mode 100644
index 0000000..04ef2ef
--- /dev/null
+++ b/frontend/src/pages/PilotLogin.tsx
@@ -0,0 +1,49 @@
+import { useState, type FormEvent } from "react";
+import { useNavigate } from "react-router-dom";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+
+export default function PilotLogin() {
+  const navigate = useNavigate();
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+
+  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const credentials = new FormData(event.currentTarget);
+    setBusy(true);
+    setError("");
+    try {
+      const response = await fetch("/api/auth/login", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(Object.fromEntries(credentials)),
+      });
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error);
+      localStorage.setItem("token", result.token);
+      localStorage.setItem("user", JSON.stringify(result.user));
+      navigate("/validation", { replace: true });
+    } catch (error) {
+      setError(error instanceof Error ? error.message : "La connexion a échoué.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return <main className="min-h-screen grid place-items-center px-4 bg-gradient-to-br from-background to-bh-light-blue">
+    <Card className="w-full max-w-md">
+      <CardHeader><CardTitle>Connexion au pilote</CardTitle></CardHeader>
+      <CardContent>
+        <form onSubmit={handleSubmit} className="space-y-4">
+          <div><Label htmlFor="email">Email</Label><Input id="email" name="email" type="email" required /></div>
+          <div><Label htmlFor="password">Mot de passe</Label><Input id="password" name="password" type="password" required /></div>
+          {error && <p role="alert" className="text-destructive">{error}</p>}
+          <Button type="submit" disabled={busy}>Se connecter</Button>
+        </form>
+      </CardContent>
+    </Card>
+  </main>;
+}
diff --git a/frontend/src/pages/PilotReview.tsx b/frontend/src/pages/PilotReview.tsx
new file mode 100644
index 0000000..5e816e1
--- /dev/null
+++ b/frontend/src/pages/PilotReview.tsx
@@ -0,0 +1,92 @@
+import { useEffect, useState } from "react";
+import { Navigate } from "react-router-dom";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+
+type Decision = "validated" | "rejected";
+
+interface Draft {
+  _id: string;
+  subject: string;
+  body: string;
+  status: "pending" | Decision;
+  reviewed_by?: string;
+  reviewed_at?: string;
+  reviewer_email?: string;
+}
+
+const endpoint = "/api/validation/pilot";
+
+export default function PilotReview() {
+  const token = localStorage.getItem("token");
+  const [drafts, setDrafts] = useState<Draft[] | null>(null);
+  const [openId, setOpenId] = useState<string>();
+  const [busy, setBusy] = useState(false);
+  const [expired, setExpired] = useState(false);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    if (!token) return;
+    const request = new AbortController();
+    fetch(endpoint, { headers: { Authorization: `Bearer ${token}` }, signal: request.signal })
+      .then(async response => {
+        if (response.status === 401) { localStorage.removeItem("token"); setExpired(true); return; }
+        if (!response.ok) throw new Error("Impossible de charger les brouillons.");
+        setDrafts(await response.json());
+      })
+      .catch(error => { if (!request.signal.aborted) setError(error.message); });
+    return () => request.abort();
+  }, [token]);
+
+  if (!token || expired) return <Navigate to="/login" replace />;
+
+  const draft = drafts?.find(row => row._id === openId);
+
+  async function record(decision: Decision) {
+    if (!draft || busy) return;
+    setBusy(true);
+    setError("");
+    try {
+      const response = await fetch(`${endpoint}/${draft._id}`, {
+        method: "PATCH",
+        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+        body: JSON.stringify({ decision }),
+      });
+      if (response.status === 401) { localStorage.removeItem("token"); setExpired(true); return; }
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error);
+      setDrafts(rows => rows?.map(row => row._id === result._id ? result : row) ?? null);
+    } catch (error) {
+      setError(error instanceof Error ? error.message : "Impossible d’enregistrer la décision.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return <div className="p-6 space-y-6">
+    <h2 className="text-2xl font-semibold">Validation des brouillons synthétiques</h2>
+    {error && <p role="alert" className="text-destructive">{error}</p>}
+    {drafts === null && !error && <p>Chargement des brouillons…</p>}
+    <ul className="space-y-2">
+      {drafts?.map(row => <li key={row._id}>
+        <Button variant="outline" aria-expanded={row._id === openId} onClick={() => setOpenId(row._id)}>
+          {row.subject} · {row.status}
+        </Button>
+      </li>)}
+    </ul>
+    {draft && <Card>
+      <CardHeader><CardTitle>{draft.subject}</CardTitle></CardHeader>
+      <CardContent className="space-y-4">
+        <p className="whitespace-pre-wrap">{draft.body}</p>
+        <p>Statut <strong>{draft.status}</strong></p>
+        {draft.status === "pending" ? <div className="flex gap-2">
+          <Button disabled={busy} onClick={() => record("validated")}>Approuver</Button>
+          <Button disabled={busy} variant="destructive" onClick={() => record("rejected")}>Rejeter</Button>
+        </div> : <dl>
+          <dt>Réviseur</dt><dd>{draft.reviewer_email ?? draft.reviewed_by}</dd>
+          <dt>Décision enregistrée (UTC)</dt><dd><time dateTime={draft.reviewed_at}>{draft.reviewed_at}</time></dd>
+        </dl>}
+      </CardContent>
+    </Card>}
+  </div>;
+}
