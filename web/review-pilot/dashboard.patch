diff --git a/backend/src/pilot-review.ts b/backend/src/pilot-review.ts
new file mode 100644
index 0000000..3035e8b
--- /dev/null
+++ b/backend/src/pilot-review.ts
@@ -0,0 +1,99 @@
+import { randomBytes } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import bcrypt from 'bcryptjs';
+import express from 'express';
+import mongoose from 'mongoose';
+import { login } from './controllers/auth.controller';
+import { authenticate, authorize } from './middleware/auth.middleware';
+import Message from './models/message.model';
+import { User } from './models/user.model';
+
+const reviewEmail = 'reviewer@example.invalid';
+const draftFields = 'subject body status reviewed_by reviewed_at';
+
+async function start() {
+  const [portValue, draftFile, frontend] = process.argv.slice(2);
+  const mongoPort = Number(portValue);
+  if (!Number.isInteger(mongoPort) || mongoPort < 1 || mongoPort > 65535 || !draftFile || !frontend) {
+    throw new Error('Usage: node dist/pilot-review.js MONGO_PORT SYNTHETIC_DRAFT_JSON FRONTEND_DIST');
+  }
+  const draft = JSON.parse(await readFile(draftFile, 'utf8'));
+  if (draft.product !== 'Synthetic Fleet Cover' || draft.status !== 'pending' ||
+      typeof draft.subject !== 'string' || typeof draft.body !== 'string') {
+    throw new Error('Expected the synthetic recommendation draft');
+  }
+
+  process.env.JWT_SECRET = randomBytes(32).toString('hex');
+  const password = randomBytes(18).toString('base64url');
+  const dbName = `bh_review_pilot_${randomBytes(12).toString('hex')}`;
+  await mongoose.connect(`mongodb://127.0.0.1:${mongoPort}/${dbName}`, {
+    directConnection: true,
+    serverSelectionTimeoutMS: 3000,
+  });
+  const reviewer = await User.create({ email: reviewEmail, password: await bcrypt.hash(password, 10), role: 'admin' });
+  await Message.insertMany(['A', 'B'].map(label => ({
+    conversation_id: new mongoose.Types.ObjectId(),
+    body: draft.body,
+    subject: `${draft.subject} ${label}`,
+    sender: 'ai',
+    direction: 'sent',
+    status: 'pending',
+  })));
+
+  const app = express();
+  app.disable('x-powered-by');
+  app.use(express.json({ limit: '4kb' }));
+  app.post('/api/auth/login', login);
+  const reviews = express.Router();
+  reviews.use(authenticate, authorize(['admin']));
+  reviews.use((_req, res, next) => { res.set('Cache-Control', 'no-store'); next(); });
+  const withReviewer = <T extends { reviewed_by?: string }>(draft: T) => ({
+    ...draft,
+    reviewer_email: draft.reviewed_by === String(reviewer._id) ? reviewer.email : undefined,
+  });
+  reviews.get('/', async (_req, res) => {
+    const rows = await Message.find().select(draftFields).sort({ subject: 1 }).lean();
+    res.json(rows.map(withReviewer));
+  });
+  reviews.patch('/:id', async (req, res) => {
+    const { id } = req.params;
+    const decision = req.body?.decision;
+    if (!mongoose.isObjectIdOrHexString(id) || !['validated', 'rejected'].includes(decision)) {
+      return res.status(400).json({ error: 'Décision ou brouillon invalide.' });
+    }
+    const updated = await Message.findOneAndUpdate(
+      { _id: id, sender: 'ai', status: 'pending' },
+      {
+        $set: { status: decision, reviewed_by: String(req.user._id) },
+        $currentDate: { reviewed_at: true },
+      },
+      { new: true, runValidators: true },
+    ).select(draftFields).lean();
+    if (!updated) return res.status(409).json({ error: 'Ce brouillon ne peut plus être validé.' });
+    res.json(withReviewer(updated));
+  });
+  app.use('/api/validation/pilot', reviews);
+  app.use('/api', (_req, res) => { res.status(404).json({ error: 'Route inconnue.' }); });
+  const frontendPath = resolve(frontend);
+  app.use(express.static(frontendPath, { index: false }));
+  app.get(['/', '/login', '/validation'], (_req, res) => { res.sendFile(resolve(frontendPath, 'index.html')); });
+
+  const server = app.listen(0, '127.0.0.1', () => {
+    const address = server.address();
+    if (!address || typeof address === 'string') return;
+    console.log(JSON.stringify({ url: `http://127.0.0.1:${address.port}`, email: reviewEmail, password }));
+  });
+  const stop = () => server.close(async () => {
+    await mongoose.connection.dropDatabase();
+    await mongoose.disconnect();
+  });
+  process.once('SIGTERM', stop);
+  process.once('SIGINT', stop);
+}
+
+start().catch(async error => {
+  console.error(error);
+  await mongoose.disconnect();
+  process.exitCode = 1;
+});
